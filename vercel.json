{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/id",
            "destination": "/id/index.html"
        },
        {
            "source": "/en",
            "destination": "/en/index.html"
        },
        {
            "source": "/admin",
            "destination": "/admin/index.html"
        },
        {
            "source": "/admin/login",
            "destination": "/admin/login/index.html"
        },
        {
            "source": "/admin/preview",
            "destination": "/admin/preview/index.html"
        },
        {
            "source": "/id/about",
            "destination": "/id/about/index.html"
        },
        {
            "source": "/id/rooms",
            "destination": "/id/rooms/index.html"
        },
        {
            "source": "/id/rooms/detail",
            "destination": "/id/rooms/detail/index.html"
        },
        {
            "source": "/id/facilities",
            "destination": "/id/facilities/index.html"
        },
        {
            "source": "/id/gallery",
            "destination": "/id/gallery/index.html"
        },
        {
            "source": "/id/testimonials",
            "destination": "/id/testimonials/index.html"
        },
        {
            "source": "/id/faq",
            "destination": "/id/faq/index.html"
        },
        {
            "source": "/id/contact",
            "destination": "/id/contact/index.html"
        },
        {
            "source": "/en/about",
            "destination": "/en/about/index.html"
        },
        {
            "source": "/en/rooms",
            "destination": "/en/rooms/index.html"
        },
        {
            "source": "/en/rooms/detail",
            "destination": "/en/rooms/detail/index.html"
        },
        {
            "source": "/en/facilities",
            "destination": "/en/facilities/index.html"
        },
        {
            "source": "/en/gallery",
            "destination": "/en/gallery/index.html"
        },
        {
            "source": "/en/testimonials",
            "destination": "/en/testimonials/index.html"
        },
        {
            "source": "/en/faq",
            "destination": "/en/faq/index.html"
        },
        {
            "source": "/en/contact",
            "destination": "/en/contact/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
                }
            ]
        },
        {
            "source": "/admin/:path*",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        }
    ]
}
